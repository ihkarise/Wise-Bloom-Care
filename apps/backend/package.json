{
  "name": "@wise-bloom/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Google Apps Script backend (v1): controllers, domain services, and the Sheets storage adapter (docs/04-Architecture/52,53).",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "build:gas": "node scripts/build-gas.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "deploy:dev": "pnpm run build:gas && npx --yes @google/clasp@3.4.1 push --force"
  },
  "dependencies": {
    "@wise-bloom/api-contract": "workspace:*",
    "@wise-bloom/domain-types": "workspace:*"
  },
  "devDependencies": {
    "@types/google-apps-script": "^1.0.99",
    "@types/node": "^22.10.2",
    "esbuild": "0.28.1",
    "eslint": "^9.17.0",
    "jiti": "^2.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
