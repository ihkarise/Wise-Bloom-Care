---
/**
 * Login route (docs/04-Architecture/51 §5, docs/04-Architecture/57 §5).
 * Static Astro shell hydrating the LoginIsland.
 */
import LoginIsland from '../features/auth/LoginIsland';
import { apiBaseUrl } from '../lib/apiConfig';
import '../styles/tokens.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Log in to Wise Bloom Care." />
    <title>Log in — Wise Bloom Care</title>
  </head>
  <body>
    <main
      class="mx-auto flex min-h-screen max-w-md flex-col justify-center gap-6 bg-surface px-6 py-16 font-sans text-text-primary"
    >
      <div>
        <p class="text-small font-medium uppercase tracking-wide text-text-secondary">
          Wise Bloom Care
        </p>
        <h1 class="text-h1 font-semibold">Log in</h1>
      </div>
      <LoginIsland client:load apiBaseUrl={apiBaseUrl()} />
    </main>
  </body>
</html>
